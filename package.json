{
  "name": "axomiya-it-labs",
  "type": "module",
  "version": "1.0.0",
  "engines": { "node": ">=22.23.4" },
  "packageManager": "pnpm@10.34.2",
  "scripts": {
    "dev": "astro dev",
    "validate:content": "node scripts/validate-content.mjs",
    "build:last-updated": "node scripts/build-last-updated.mjs",
    "build": "pnpm validate:content && pnpm build:last-updated && astro build && pnpm postbuild",
    "postbuild": "pagefind --site dist --glob **/*.html",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "pagefind": "^1.6.0"
  }
}