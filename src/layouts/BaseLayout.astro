---
import '../styles/global.css';
import { useTranslations, defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { 
  lang, 
  title, 
  description = 'Axomiya IT Labs — Assam\'s first AI & open-source community.',
  ogImage = '/brand/og-image.webp',
  ogType = 'website'
} = Astro.props;

const t = useTranslations(lang);

const siteName = 'Axomiya IT Labs';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const isAs = lang === 'as';
const enPath = isAs ? currentPath.replace(/^\/as/, '') || '/' : currentPath;
const asPath = isAs ? currentPath : (currentPath === '/' ? '/as/' : `/as${currentPath}`);
const enURL = new URL(enPath, Astro.site);
const asURL = new URL(asPath, Astro.site);
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/social/icon.svg" />
    
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          } else {
            document.documentElement.dataset.theme = 'system';
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'system';
        }
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="as" href={asURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === 'en' ? 'en_IN' : 'as_IN'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="alternate" type="application/rss+xml" title={siteName} href={lang === 'en' ? '/rss.xml' : '/as/rss.xml'} />
    <link rel="llms" href="/llms.txt" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    
    <Header lang={lang} />
    
    <!-- Search Modal (rendered once, globally available) -->
    <SearchModal lang={lang} />
    
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    
    <Footer lang={lang} />
  </body>
</html>