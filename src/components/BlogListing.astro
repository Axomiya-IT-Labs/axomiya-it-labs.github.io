---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const posts = (await getCollection('blog', (entry) => entry.data.lang === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang={lang} title={t.blog} translationSlug="blog" section="pages" placeholder={lang === 'as'}>
	<section class="container section"><span class="eyebrow">{t.blog}</span><h1>{t.latest}</h1><div class="card-grid">{posts.map((post) => <a class="card" href={localizedPath(lang, `/blog/${post.data.translationSlug}/`)}><span class="eyebrow">{post.data.pubDate.toLocaleDateString(lang === 'as' ? 'as-IN' : 'en-US', { dateStyle: 'long' })}</span><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="meta">{t.readMore} →</span></a>)}</div>{posts.length === 0 && <p>{t.noPosts}</p>}</section>
</BaseLayout>
