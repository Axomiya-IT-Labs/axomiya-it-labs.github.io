---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareButtons from './ShareButtons.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
const { entry, kind } = Astro.props;
const lang = entry.data.lang as Lang;
const { Content } = await render(entry);
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} translationSlug={entry.data.translationSlug} section={kind} heroImage={entry.data.heroImage} placeholder={entry.data.placeholder} contentDate={entry.data.pubDate} author={entry.data.author} repo={entry.data.repo}>
	<article class="container section"><header class="post-header">{kind === 'announcements' && entry.data.heroImage && <img class="post-hero" src={entry.data.heroImage} alt="" />}<span class="eyebrow">{entry.data.type || entry.data.status} · {entry.data.category}</span><h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p><p class="meta">{t.publishedOn} {entry.data.pubDate.toLocaleDateString(lang === 'as' ? 'as-IN' : 'en-US', { dateStyle: 'long' })}{entry.data.author && ` · ${entry.data.author}`}</p></header><ShareButtons title={entry.data.title} /><div class="prose"><Content /></div>{kind === 'projects' && entry.data.repo && <p><a href={entry.data.repo}>GitHub repository →</a></p>}{kind === 'projects' && entry.data.demo && <p><a href={entry.data.demo}>Open project →</a></p>}</article>
</BaseLayout>
