---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-border bg-bg py-12 text-fg-muted">
  <div class="container-prose grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    
    <!-- Brand Column -->
    <div class="lg:col-span-1 space-y-4">
      <a href={localizePath('/', lang)} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-fg">
        <img src="/brand/logo.png" alt="Axomiya IT Labs" class="h-8 w-auto" onerror="this.style.display='none'" />
        <span>Axomiya <span class="text-accent">IT Labs</span></span>
      </a>
      <p class="text-sm max-w-sm leading-relaxed">
        Rooted in Assam — Assam's first AI & open-source community. Everyone is welcome.
      </p>
      <p class="text-sm font-medium pt-2">
        {t('footer.built')}
      </p>
    </div>

    <!-- Explore Column (Moved from Header) -->
    <div>
      <h3 class="font-semibold text-fg mb-4 text-sm uppercase tracking-wider">Explore</h3>
      <ul class="space-y-3 text-sm">
        <li><a href={localizePath('/about/', lang)} class="hover:text-accent transition-colors">About</a></li>
        <li><a href={localizePath('/community/', lang)} class="hover:text-accent transition-colors">Community</a></li>
        <li><a href={localizePath('/team/', lang)} class="hover:text-accent transition-colors">Team</a></li>
        <li><a href={localizePath('/announcements/', lang)} class="hover:text-accent transition-colors">Announcements</a></li>
        <li><a href={localizePath('/contribute/', lang)} class="hover:text-accent transition-colors">Contribute</a></li>
      </ul>
    </div>

    <!-- Resources Column -->
    <div>
      <h3 class="font-semibold text-fg mb-4 text-sm uppercase tracking-wider">Resources</h3>
      <ul class="space-y-3 text-sm">
        <li><a href={localizePath('/research/', lang)} class="hover:text-accent transition-colors">Research</a></li>
        <li><a href={localizePath('/blog/', lang)} class="hover:text-accent transition-colors">Blog</a></li>
        <li><a href={localizePath('/projects/', lang)} class="hover:text-accent transition-colors">Projects</a></li>
      </ul>
    </div>

    <!-- Connect Column -->
    <div>
      <h3 class="font-semibold text-fg mb-4 text-sm uppercase tracking-wider">Connect</h3>
      <div class="flex gap-4 mb-6">
        <a href="https://github.com/Axomiya-IT-Labs" target="_blank" rel="noopener noreferrer" class="text-fg-muted hover:text-fg group bg-bg-subtle p-2 rounded-full border border-border transition-colors hover:border-accent">
          <img src="/social/github.svg" alt="GitHub" class="w-5 h-5 opacity-70 group-hover:opacity-100 dark:invert" />
        </a>
        <a href="https://t.me/AxomiyaITLabs" target="_blank" rel="noopener noreferrer" class="text-fg-muted hover:text-fg group bg-bg-subtle p-2 rounded-full border border-border transition-colors hover:border-accent">
          <img src="/social/telegram.svg" alt="Telegram" class="w-5 h-5 opacity-70 group-hover:opacity-100 dark:invert" />
        </a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="text-fg-muted hover:text-fg group bg-bg-subtle p-2 rounded-full border border-border transition-colors hover:border-accent">
          <img src="/social/x.svg" alt="X" class="w-5 h-5 opacity-70 group-hover:opacity-100 dark:invert" />
        </a>
      </div>
    </div>

  </div>
  
  <!-- Bottom Bar -->
  <div class="container-prose mt-12 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-fg-muted">
    <p>© {year} Axomiya IT Labs. {t('footer.rights')}</p>
    <div class="flex gap-4">
      <a href="/rss.xml" class="hover:text-fg">RSS Feed</a>
      <a href="/sitemap-index.xml" class="hover:text-fg">Sitemap</a>
      <a href="/llms.txt" class="hover:text-fg">llms.txt</a>
    </div>
  </div>
</footer>