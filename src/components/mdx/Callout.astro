---
interface Props {
  type?: 'info' | 'warning' | 'success';
  title?: string;
}

const { 
  type = 'info', 
  title = 'Note' 
} = Astro.props;

const styles = {
  info: 'border-blue-500 bg-blue-500/10 text-blue-900 dark:text-blue-100',
  warning: 'border-yellow-500 bg-yellow-500/10 text-yellow-900 dark:text-yellow-100',
  success: 'border-green-500 bg-green-500/10 text-green-900 dark:text-green-100'
};
---
<div class={`my-6 rounded-r-lg border-l-4 p-4 ${styles[type]}`}>
  <div class="flex items-center gap-2 mb-1">
    <span class="font-bold text-sm uppercase tracking-wider">{title}</span>
  </div>
  <div class="text-sm prose-p:my-0">
    <slot />
  </div>
</div>