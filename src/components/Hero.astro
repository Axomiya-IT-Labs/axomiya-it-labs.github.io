---
interface Props {
  eyebrow: string;
  title: string;
  titleAccent: string;
  tagline: string;
  primaryBtnText: string;
  primaryBtnLink: string;
  secondaryBtnText: string;
  secondaryBtnLink: string;
}

const { 
  eyebrow, 
  title, 
  titleAccent, 
  tagline, 
  primaryBtnText, 
  primaryBtnLink, 
  secondaryBtnText, 
  secondaryBtnLink 
} = Astro.props;
---
<section class="relative flex flex-col items-center justify-center min-h-[calc(100vh-4rem)] text-center px-4 overflow-hidden border-b border-border bg-bg">
  
  <!-- Background Video -->
  <video 
    autoplay 
    loop 
    muted 
    playsinline 
    preload="metadata"
    poster="/assets/hero/nature-poster.jpg"
    class="absolute inset-0 w-full h-full object-cover opacity-30 dark:opacity-40"
    aria-hidden="true"
  >
    <source src="/assets/hero/nature.mp4" type="video/mp4" />
  </video>

  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-bg/70 dark:bg-bg/80"></div>
  
  <!-- Subtle radial gradient for depth -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--color-accent-soft)_0%,_transparent_70%)] opacity-40 pointer-events-none"></div>
  
  <div class="relative z-10 max-w-4xl mx-auto space-y-6">
    <span class="eyebrow text-sm md:text-base tracking-widest mb-2">{eyebrow}</span>
    
    <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-black font-display tracking-tighter leading-[0.95] text-fg">
      {title} <br/>
      <span class="text-accent">{titleAccent}</span>
    </h1>
    
    <p class="text-base sm:text-lg md:text-xl text-fg-muted font-medium max-w-2xl mx-auto mt-6 leading-relaxed px-2">
      {tagline}
    </p>
    
    <div class="pt-8 md:pt-10 flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4">
      <a href={primaryBtnLink} class="btn-primary text-base md:text-lg px-8 py-3.5 w-full sm:w-auto shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all">
        {primaryBtnText}
      </a>
      <a href={secondaryBtnLink} class="btn-secondary text-base md:text-lg px-8 py-3.5 w-full sm:w-auto hover:-translate-y-0.5 transition-all">
        {secondaryBtnText}
      </a>
    </div>
  </div>
</section>