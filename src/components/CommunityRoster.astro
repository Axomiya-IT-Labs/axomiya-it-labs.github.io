---
import { communityData } from '../data/community';

// TODO: These source assets are missing; replace the fallback when the originals are added.
const missingImages = new Set([
	'/assets/images/community/members/bhaskar.jpg',
	'/assets/images/community/members/nabanita.jpg',
	'/assets/images/community/members/ananta.jpg',
]);
const placeholderAvatar = '/assets/images/team/placeholders/avatar.svg';
const avatarFor = (image: string) => missingImages.has(image) ? placeholderAvatar : image;
const people = [
	...communityData.featured_members.map((member) => ({ ...member, badge: member.role })),
	...communityData.recent_contributors.map((member) => ({ ...member, badge: member.badge })),
];
---
<section class="container section" aria-labelledby="community-members-heading">
	<div class="section-heading"><div><p class="eyebrow">Community</p><h2 id="community-members-heading">Featured members</h2></div></div>
	<div class="card-grid community-roster">
		{people.map((person) => <article class="card member-card"><img src={avatarFor(person.image)} alt={`${person.name} avatar`} width="72" height="72" /><div><h3>{person.name}</h3><p>{person.badge}</p>{'location' in person && <p class="meta">{person.location}</p>}</div></article>)}
	</div>
</section>
