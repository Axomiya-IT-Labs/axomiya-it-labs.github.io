---
import type { CollectionEntry } from 'astro:content';
import { localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'projects'> | CollectionEntry<'announcements'>;
  lang: Lang;
  type: 'blog' | 'projects' | 'announcements';
}

const { entry, lang, type } = Astro.props;
const { title, description, pubDate, heroImage, tags, status, category } = entry.data;
const href = localizePath(`/${type}/${entry.data.translationSlug}/`, lang);
const date = new Date(pubDate).toLocaleDateString(lang === 'en' ? 'en-IN' : 'as-IN', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---
<article class="card flex flex-col h-full overflow-hidden p-0">
  {heroImage && (
    <a href={href} class="aspect-video w-full overflow-hidden bg-bg-subtle block relative">
      <img src={heroImage} alt={title} class="object-cover w-full h-full transition-transform duration-500 hover:scale-105" loading="lazy" />
    </a>
  )}
  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-3 text-xs text-fg-muted">
      {type === 'projects' && status && <span class="badge badge-accent">{status}</span>}
      {type === 'announcements' && <span class="badge">Announcement</span>}
      {type === 'blog' && <time datetime={new Date(pubDate).toISOString()}>{date}</time>}
    </div>
    
    <h3 class="text-xl font-bold font-display leading-snug mb-2">
      <a href={href} class="text-fg hover:text-accent transition-colors">{title}</a>
    </h3>
    
    <p class="text-fg-muted text-sm line-clamp-3 mb-4 flex-1">
      {description}
    </p>
    
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-border">
        {tags.slice(0, 3).map(tag => <span class="badge text-[10px]">{tag}</span>)}
      </div>
    )}
  </div>
</article>