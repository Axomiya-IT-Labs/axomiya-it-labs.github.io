---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { key: 'nav.blog', path: '/blog/' },
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.research', path: '/research/' },
];

const isActive = (path: string) => {
  const localized = localizePath(path, lang);
  return currentPath.startsWith(localized);
};
---
<header class="sticky top-0 z-40 w-full border-b border-border bg-bg/80 backdrop-blur-md">
  <div class="container-prose flex h-16 items-center justify-between gap-4">
    
    <!-- Logo -->
    <a href={localizePath('/', lang)} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-fg hover:opacity-80 transition-opacity shrink-0">
      <img src="/brand/logo.png" alt="Axomiya IT Labs" class="h-8 w-auto" onerror="this.style.display='none'" />
      <span>Axomiya <span class="text-accent">IT Labs</span></span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1 flex-1 justify-center">
      {navItems.map(item => (
        <a 
          href={localizePath(item.path, lang)} 
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${isActive(item.path) ? 'text-accent bg-accent-soft' : 'text-fg-muted hover:text-fg hover:bg-bg-subtle'}`}
        >
          {t(item.key as any)}
        </a>
      ))}
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden md:flex items-center gap-2 shrink-0">
      <button id="search-trigger" type="button" class="btn-ghost rounded-full p-2" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <ThemeToggle lang={lang} />
      <LanguageToggle lang={lang} />
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden btn-ghost rounded-full p-2 text-fg" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile Nav Drawer (Hidden by default) -->
  <div id="mobile-drawer" class="fixed inset-0 z-50 hidden bg-bg md:hidden flex flex-col">
    <!-- Drawer Header -->
    <div class="container-prose flex h-16 items-center justify-between border-b border-border shrink-0">
      <span class="font-display font-bold text-fg text-lg">Menu</span>
      <button id="mobile-close-btn" class="btn-ghost p-2 rounded-full" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Drawer Nav Links -->
    <nav class="container-prose flex flex-col py-6 gap-2 flex-1 overflow-y-auto">
      {navItems.map(item => (
        <a 
          href={localizePath(item.path, lang)} 
          class={`block px-4 py-3 rounded-lg text-lg font-semibold transition-colors ${isActive(item.path) ? 'bg-accent-soft text-accent' : 'text-fg hover:bg-bg-subtle'}`}
        >
          {t(item.key as any)}
        </a>
      ))}
    </nav>

    <!-- Drawer Bottom Controls (Theme + Language) -->
    <div class="border-t border-border bg-bg-elevated shrink-0">
      <div class="container-prose flex flex-col gap-4 py-6">
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-fg-muted">Theme</span>
          <ThemeToggle lang={lang} />
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-fg-muted">Language</span>
          <LanguageToggle lang={lang} />
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  window.addEventListener('load', function () {
    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-close-btn');
    const drawer = document.getElementById('mobile-drawer');
    
    if (btn && drawer) {
      btn.addEventListener('click', () => {
        drawer.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });
    }
    
    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', () => {
        drawer.classList.add('hidden');
        document.body.style.overflow = '';
      });
    }
  });
</script>