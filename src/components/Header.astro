---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { key: 'nav.blog', path: '/blog/' },
  { key: 'nav.projects', path: '/projects/' },
  { key: 'nav.research', path: '/research/' },
];

const isActive = (path: string) => {
  const localized = localizePath(path, lang);
  return currentPath.startsWith(localized);
};
---
<header class="sticky top-0 z-40 w-full border-b border-border bg-bg/80 backdrop-blur-md">
  <div class="container-prose flex h-16 items-center justify-between gap-4">
    
    <!-- Logo -->
    <a href={localizePath('/', lang)} class="flex items-center gap-2 font-display text-lg font-bold tracking-tight text-fg hover:opacity-80 transition-opacity shrink-0">
      <img src="/brand/logo.png" alt="Axomiya IT Labs" class="h-8 w-auto" onerror="this.style.display='none'" />
      <span>Axomiya <span class="text-accent">IT Labs</span></span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1 flex-1 justify-center">
      {navItems.map(item => (
        <a 
          href={localizePath(item.path, lang)} 
          class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${isActive(item.path) ? 'text-accent bg-accent-soft' : 'text-fg-muted hover:text-fg hover:bg-bg-subtle'}`}
        >
          {t(item.key as any)}
        </a>
      ))}
    </nav>

    <!-- Search and appearance controls stay grouped on the right -->
    <div class="flex items-center gap-1 md:gap-2 shrink-0">
      <button id="search-trigger" type="button" class="btn-ghost rounded-full p-2" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <ThemeToggle lang={lang} />
      <span class="hidden md:contents"><LanguageToggle lang={lang} /></span>
      <!-- Mobile menu trigger sits immediately after Theme -->
      <button id="mobile-menu-btn" type="button" class="mobile-menu-trigger md:hidden btn-ghost rounded-full p-2" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="menu-icon-close hidden" xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu-backdrop" class="mobile-menu-backdrop hidden md:hidden" aria-hidden="true"></div>
  <nav id="mobile-menu" aria-label="Mobile navigation" class="mobile-menu-panel hidden md:hidden" inert>
    <p class="mobile-menu-label">Explore</p>
    {navItems.map(item => (
      <a href={localizePath(item.path, lang)} class={`mobile-menu-link ${isActive(item.path) ? 'is-active' : ''}`}>
        <span>{t(item.key as any)}</span><span class="mobile-menu-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-controls">
      <div class="mobile-menu-control">
        <span>Language</span>
        <LanguageToggle lang={lang} />
      </div>
    </div>
  </nav>
</header>

<style>
  .mobile-menu-trigger { color: var(--color-fg); }
  .mobile-menu-backdrop {
    position: fixed;
    inset: 4rem 0 0;
    z-index: 38;
    background: rgb(12 16 14 / 22%);
    backdrop-filter: blur(2px);
  }
  .mobile-menu-panel {
    position: absolute;
    z-index: 41;
    top: calc(100% + 0.55rem);
    right: max(1rem, calc((100vw - 1120px) / 2 + 1.5rem));
    width: min(21rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 75%, white 25%);
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--color-bg-elevated) 82%, transparent);
    box-shadow: 0 20px 60px rgb(0 0 0 / 18%), 0 2px 8px rgb(0 0 0 / 8%);
    backdrop-filter: blur(24px) saturate(1.35);
    transform-origin: top right;
  }
  .mobile-menu-panel:not(.hidden) { animation: menu-drop 160ms ease-out both; }
  .mobile-menu-label {
    margin: 0.1rem 0.5rem 0.55rem;
    color: var(--color-fg-subtle);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .mobile-menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.35rem;
    padding: 0.7rem 0.8rem;
    border-radius: 0.75rem;
    color: var(--color-fg);
    font-weight: 600;
    transition: background-color 140ms ease, color 140ms ease;
  }
  .mobile-menu-link:hover,
  .mobile-menu-link.is-active {
    color: var(--color-accent);
    background: var(--color-accent-soft);
    text-decoration: none;
  }
  .mobile-menu-arrow { color: var(--color-fg-subtle); font-size: 0.9rem; }
  .mobile-menu-divider { height: 1px; margin: 0.7rem 0.4rem; background: var(--color-border); }
  .mobile-menu-controls {
    display: grid;
    gap: 0.45rem;
  }
  .mobile-menu-control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.7rem;
    padding: 0.15rem 0.55rem;
    color: var(--color-fg-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .mobile-menu-control a { border: 1px solid var(--color-border); border-radius: 999px; background: rgb(255 255 255 / 18%); }
  @keyframes menu-drop {
    from { opacity: 0; transform: translateY(-5px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel:not(.hidden) { animation: none; }
  }
</style>

<script is:inline>
  (() => {
    const trigger = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    if (!trigger || !menu || !backdrop) return;
    const openIcon = trigger.querySelector('.menu-icon-open');
    const closeIcon = trigger.querySelector('.menu-icon-close');

    const openMenu = () => {
      menu.classList.remove('hidden');
      menu.removeAttribute('inert');
      backdrop.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
      trigger.setAttribute('aria-label', 'Close navigation menu');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    };
    const closeMenu = (restoreFocus = false) => {
      menu.classList.add('hidden');
      menu.setAttribute('inert', '');
      backdrop.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
      trigger.setAttribute('aria-label', 'Open navigation menu');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      if (restoreFocus) trigger.focus();
    };

    trigger.addEventListener('click', () => {
      if (trigger.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });
    backdrop.addEventListener('click', () => closeMenu());
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
    document.addEventListener('click', event => {
      if (trigger.getAttribute('aria-expanded') === 'true' && !menu.contains(event.target) && !trigger.contains(event.target)) closeMenu();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') closeMenu(true);
    });
    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) closeMenu();
    });
  })();
</script>
