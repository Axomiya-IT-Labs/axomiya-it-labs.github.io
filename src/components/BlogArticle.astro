---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
const { post } = Astro.props;
const lang = post.data.lang as Lang;
const { Content } = await render(post);
const t = useTranslations(lang);
const minutes = Math.max(1, Math.ceil(post.body.split(/\s+/).filter(Boolean).length / (lang === 'as' ? 180 : 220)));
---
<BaseLayout lang={lang} title={post.data.title} description={post.data.description} translationSlug={post.data.translationSlug} section="blog" heroImage={post.data.heroImage} placeholder={post.data.placeholder} contentDate={post.data.pubDate} author={post.data.author}>
	<article class="container section"><header class="post-header">{post.data.heroImage && <img class="post-hero" src={post.data.heroImage} alt="" />}<p class="eyebrow">{t.publishedOn} {post.data.pubDate.toLocaleDateString(lang === 'as' ? 'as-IN' : 'en-US', { dateStyle: 'long' })} · {minutes} min read</p><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p></header><div class="prose"><Content /></div></article>
</BaseLayout>
