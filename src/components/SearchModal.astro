---
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<div id="search-overlay" style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); align-items: flex-start; justify-content: center; padding-top: 10vh; padding-left: 16px; padding-right: 16px;">
  <div style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-radius: 12px; width: 100%; max-width: 600px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden; display: flex; flex-direction: column;">
    
    <div style="display: flex; align-items: center; padding: 0 16px; border-bottom: 1px solid var(--color-border);">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-fg-muted); flex-shrink: 0;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      
      <input 
        type="text" 
        id="search-input" 
        placeholder={t('search.placeholder')} 
        style="width: 100%; background: transparent; border: none; padding: 16px; color: var(--color-fg); font-size: 18px; outline: none;"
        autocomplete="off"
      />
      
      <button id="search-close" type="button" style="background: transparent; border: 1px solid var(--color-border); border-radius: 4px; padding: 4px 8px; font-size: 12px; color: var(--color-fg-muted); cursor: pointer; flex-shrink: 0;">ESC</button>
    </div>
    
    <div id="search-results" style="padding: 8px; max-height: 60vh; overflow-y: auto;">
      <div style="padding: 32px; text-align: center; color: var(--color-fg-muted); font-size: 14px;">Type at least 2 characters...</div>
    </div>
    
  </div>
</div>

<script is:inline>
  // Wait for the page to fully load before attaching listeners.
  // Without this, getElementById returns null because the DOM hasn't parsed yet.
  window.addEventListener('load', function() {
    initSearch();
  });

  function initSearch() {
    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const trigger = document.getElementById('search-trigger');
    const closeBtn = document.getElementById('search-close');

    if (!overlay || !input || !trigger) {
      console.error('Search: required elements missing from DOM', { overlay, input, trigger });
      return;
    }

    let pagefind = null;
    let searchTimeout = null;

    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        // @ts-ignore
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.options({ excerptLength: 20 });
        await pagefind.init();
        return pagefind;
      } catch (e) {
        console.error("Pagefind load failed:", e);
        return null;
      }
    }

    function openSearch() {
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      setTimeout(function() {
        input.focus();
        input.select();
      }, 100);
      loadPagefind();
    }

    function closeSearch() {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
      input.value = '';
      resultsContainer.innerHTML = '<div style="padding: 32px; text-align: center; color: var(--color-fg-muted); font-size: 14px;">Type at least 2 characters...</div>';
    }

    async function doSearch(term) {
      term = term.trim();
      if (term.length < 2) {
        resultsContainer.innerHTML = '<div style="padding: 32px; text-align: center; color: var(--color-fg-muted); font-size: 14px;">Type at least 2 characters...</div>';
        return;
      }
      
      const pf = await loadPagefind();
      if (!pf) {
        resultsContainer.innerHTML = '<div style="padding: 32px; text-align: center; color: var(--color-danger); font-size: 14px;">Search index not built yet. Run pnpm build to test.</div>';
        return;
      }

      resultsContainer.innerHTML = '<div style="padding: 32px; text-align: center; color: var(--color-fg-muted); font-size: 14px;">Searching...</div>';
      
      try {
        const search = await pf.search(term);

        if (search.results.length === 0) {
          resultsContainer.innerHTML = '<div style="padding: 32px; text-align: center; color: var(--color-fg-muted); font-size: 14px;">No results found for "' + term + '".</div>';
          return;
        }

        const topResults = search.results.slice(0, 10);
        const html = await Promise.all(topResults.map(async function(result) {
          const data = await result.data();
          const title = data.meta.title || data.url;
          const excerpt = data.excerpt || '';
          const isAs = data.url.startsWith('/as/');
          
          const langBadge = isAs 
            ? '<span style="display: inline-block; font-size: 10px; padding: 2px 6px; border-radius: 4px; background: var(--color-accent-soft); color: var(--color-accent); font-weight: bold; margin-right: 8px;">AS</span>' 
            : '<span style="display: inline-block; font-size: 10px; padding: 2px 6px; border-radius: 4px; background: var(--color-bg-subtle); color: var(--color-fg-muted); font-weight: bold; margin-right: 8px;">EN</span>';
          
          return '<a href="' + data.url + '" style="display: block; padding: 12px; border-radius: 8px; text-decoration: none; color: inherit;" onmouseover="this.style.background=\'var(--color-bg-subtle)\'" onmouseout="this.style.background=\'transparent\'">' +
            '<div style="font-weight: 600; color: var(--color-fg); font-size: 14px; display: flex; align-items: center;">' + langBadge + title + '</div>' +
            '<div style="color: var(--color-fg-muted); font-size: 12px; margin-top: 4px;">' + excerpt + '</div>' +
            '</a>';
        }));
        
        resultsContainer.innerHTML = html.join('');
      } catch (e) {
        console.error(e);
        resultsContainer.innerHTML = '<div style="padding: 32px; text-align: center; color: var(--color-danger); font-size: 14px;">Search error. See console.</div>';
      }
    }

    trigger.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      openSearch();
    });

    closeBtn.addEventListener('click', closeSearch);

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeSearch();
    });

    input.addEventListener('input', function(e) {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(function() { doSearch(e.target.value); }, 150);
    });

    window.addEventListener('keydown', function(e) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (overlay.style.display === 'none') openSearch();
        else closeSearch();
      }
      if (e.key === 'Escape' && overlay.style.display === 'flex') {
        closeSearch();
      }
    });
  }
</script>