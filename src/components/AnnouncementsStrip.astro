---
import type { Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';
import { localizePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Fetch the latest announcement for this language
const announcements = (await getCollection('announcements', ({ data }) => data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 1);

const latest = announcements[0];

// Strip any "[AS]" prefix if present
const title = latest?.data.title.replace(/^\[AS\]\s*/i, '') || '';

// Labels
const labels = {
  en: {
    badge: 'Latest Update',
    linkText: 'Read announcement →',
    linkUrl: latest ? localizePath(`/announcements/${latest.data.translationSlug}/`, lang) : '/announcements/'
  },
  as: {
    badge: 'শেহতীয়া আপডেট',
    linkText: 'ঘোষণা পঢ়ক →',
    linkUrl: latest ? localizePath(`/announcements/${latest.data.translationSlug}/`, lang) : '/as/announcements/'
  }
};
const t = labels[lang];

// Format date
const date = latest ? new Date(latest.data.pubDate).toLocaleDateString(
  lang === 'en' ? 'en-IN' : 'as-IN',
  { year: 'numeric', month: 'short', day: 'numeric' }
) : '';
---
{latest && (
  <section id="announcements" class="py-16 bg-bg-subtle border-b border-border">
    <div class="container-prose">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="badge badge-accent">{t.badge}</span>
          <time datetime={new Date(latest.data.pubDate).toISOString()} class="text-xs text-fg-muted font-mono">{date}</time>
        </div>
        
        <h2 class="text-2xl md:text-3xl font-bold font-display text-fg mb-3 leading-tight">
          {title}
        </h2>
        
        {latest.data.description && (
          <p class="text-fg-muted text-base md:text-lg max-w-xl mx-auto mb-6 leading-relaxed">
            {latest.data.description}
          </p>
        )}
        
        <a href={t.linkUrl} class="btn-secondary">{t.linkText}</a>
      </div>
    </div>
  </section>
)}