---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const [home] = await getCollection('pages', (entry) => entry.data.lang === lang && entry.data.translationSlug === 'home');
const { Content } = home ? await render(home) : { Content: () => null };
const posts = (await getCollection('blog', (entry) => entry.data.lang === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
const announcements = (await getCollection('announcements', (entry) => entry.data.lang === lang)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const dateLocale = lang === 'as' ? 'as-IN' : 'en-US';
---
<BaseLayout lang={lang} title={home?.data.title ?? (lang === 'as' ? '[AS] Home' : 'Home')} description={lang === 'as' ? t.latestSubtitle : 'Assam’s first AI and open-source community.'} translationSlug="home" placeholder={home?.data.placeholder}>
	<section class="container hero masthead">
		<p class="eyebrow">Rooted in Assam · Open to Everyone</p>
		<h1>Axomiya IT Labs</h1>
		<p class="lead">{lang === 'as' ? 'সকলোৰে বাবে সমান সুবিধা — AI সকলোৰে বাবে সহজ কৰা।' : 'Equal access for all — making AI easy for everyone.'}</p>
		<a class="button" href={localizedPath(lang, '/community/')}>{lang === 'as' ? 'সমাজত যোগ দিয়ক' : 'Join the community'}</a>
	</section>
	{home && <div class="legacy-home"><Content /></div>}
	<section class="container section">
		<div class="section-heading"><div><h2>{t.latest}</h2><p class="lead">{t.latestSubtitle}</p></div><a href={localizedPath(lang, '/blog/')}>{t.viewAll} →</a></div>
		<div class="card-grid">{posts.map((post) => <a class="card" href={localizedPath(lang, `/blog/${post.data.translationSlug}/`)}><span class="eyebrow">{post.data.pubDate.toLocaleDateString(dateLocale, { dateStyle: 'long' })}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="meta">{t.readMore} →</span></a>)}{posts.length === 0 && <p>{t.noPosts}</p>}</div>
	</section>
	<section class="container section"><div class="section-heading"><div><h2>{t.latestAnnouncements}</h2><p class="lead">{t.announcementSummary}</p></div><a href={localizedPath(lang, '/announcements/')}>{t.viewAll} →</a></div><div class="card-grid">{announcements.map((item) => <a class="card" href={localizedPath(lang, `/announcements/${item.data.translationSlug}/`)}><span class="eyebrow">{item.data.type || item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.description}</p><span class="meta">{item.data.pubDate.toLocaleDateString(dateLocale)} · {t.readMore} →</span></a>)}</div></section>
</BaseLayout>
