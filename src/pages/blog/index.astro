---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.lang === 'en')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="en" title="Blog">
  <div class="container-prose py-16">
    <header class="mb-12">
      <h1 class="display mb-4">Blog</h1>
      <p class="lead">Tutorials, deep dives, and updates from the community.</p>
    </header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map(post => <ContentCard entry={post} lang="en" type="blog" />)}
    </div>
  </div>
</BaseLayout>