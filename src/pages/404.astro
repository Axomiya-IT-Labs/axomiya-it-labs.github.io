---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Page not found | Axomiya IT Labs</title>
		<meta name="robots" content="noindex,follow" />
		<meta name="description" content="The page you requested could not be found." />
	</head>
	<body>
		<main class="container section" style="min-height:100vh;display:grid;place-content:center;text-align:center">
			<p class="eyebrow">404 · Page not found</p>
			<h1 style="margin-inline:auto">This page has moved or does not exist.</h1>
			<p class="lead" style="margin-inline:auto">Try the homepage or browse the latest writing.</p>
			<p><a class="button" href="/">Go to homepage</a> <a href="/blog/">Browse the blog</a></p>
		</main>
	</body>
</html>
