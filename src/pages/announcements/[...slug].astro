---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const items = await getCollection('announcements', ({ data }) => data.lang === 'en');
  return items.map(item => ({
    params: { slug: item.data.translationSlug },
    props: { item }
  }));
};

const { item } = Astro.props;
const { Content } = await render(item);
const announcementUrl = new URL(Astro.url.pathname, Astro.site).toString();

const title = item.data.title.replace(/^\[AS\]\s*/i, '');
---
<BaseLayout 
  lang="en" 
  title={title} 
  description={item.data.description} 
  ogType="article"
  ogImage={item.data.ogImage || item.data.heroImage}
>
  <article class="container-prose py-16">
    <header class="mb-12 text-center max-w-3xl mx-auto">
      <span class="badge badge-accent mb-4">Announcement</span>
      <h1 class="display mb-4">{title}</h1>
      <time datetime={new Date(item.data.pubDate).toISOString()} class="text-fg-muted">
        {new Date(item.data.pubDate).toLocaleDateString('en-IN', { dateStyle: 'long' })}
      </time>
      {item.data.heroImage && (
        <img 
          src={item.data.heroImage} 
          alt={title} 
          class="w-full h-auto max-h-[400px] object-cover rounded-xl shadow-lg mt-8" 
        />
      )}
    </header>
    <Prose>
      <Content />
    </Prose>
    <div class="max-w-[68ch] mx-auto">
      <ShareButtons lang="en" url={announcementUrl} title={title} />
    </div>
  </article>
</BaseLayout>