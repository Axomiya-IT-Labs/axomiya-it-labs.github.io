---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => data.lang === 'en')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="en" title="Research">
  <div class="container-prose py-16">
    <header class="mb-12">
      <h1 class="display mb-4">Research & Articles</h1>
      <p class="lead">Deep dives, technical breakdowns, and case studies.</p>
    </header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map(post => <ContentCard entry={post} lang="en" type="research" />)}
      {posts.length === 0 && <p class="text-fg-muted">No research articles published yet.</p>}
    </div>
  </div>
</BaseLayout>
