---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => data.lang === 'en')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="en" title="Research">
  <div class="container-prose py-16">
    <header class="mb-12 text-center">
      <h1 class="display mb-4">Research & Articles</h1>
      <p class="lead mx-auto">Deep dives, technical breakdowns, and case studies from our community.</p>
    </header>

    {posts.length > 0 ? (
      <div class="flex flex-wrap justify-center gap-6">
        {posts.map(post => (
          <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
            <ContentCard entry={post} lang="en" type="research" />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-fg-muted py-12">No research articles published yet.</p>
    )}
  </div>
</BaseLayout>