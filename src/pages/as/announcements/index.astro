---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const announcements = (await getCollection('announcements', ({ data }) => data.lang === 'as'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="as" title="ঘোষণা">
  <div class="container-prose py-12 md:py-16">
    <header class="mb-8 md:mb-12">
      <h1 class="display mb-4">ঘোষণা</h1>
      <p class="lead">Axomiya IT Labs-ৰ খবৰ আৰু আপডেট।</p>
    </header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {announcements.map(item => <ContentCard entry={item} lang="as" type="announcements" />)}
      {announcements.length === 0 && <p class="text-fg-muted">এতিয়ালৈকে কোনো ঘোষণা প্ৰকাশ কৰা হোৱা নাই।</p>}
    </div>
  </div>
</BaseLayout>
