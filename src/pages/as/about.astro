---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="as" title="আমাৰ বিষয়ে">
  <article class="container-prose py-16">
    
    <header class="mb-16 text-center max-w-3xl mx-auto">
      <span class="eyebrow mb-4 inline-block">কিয় আমি আছোঁ</span>
      <h1 class="display mb-6">
        তথ্য বিনামূলীয়া।<br/>
        <span class="text-accent">বুজাটো পৰৱৰ্তী পদক্ষেপ।</span>
      </h1>
      <p class="lead mx-auto">
        Axomiya IT Labs ইয়াৰ বাবেই আছে — কাৰণ জ্ঞানৰ অভিগম আৰু জ্ঞানৰ বুজাৰ মাজত পাৰ্থক্য আছে, বিশেষকৈ যেতিয়া সেই জ্ঞান আপোনাৰ ভাষাত নহয়।
      </p>
    </header>

    <section class="mb-16">
      <div class="content-prose mx-auto">
        <span class="eyebrow">০১ — প্ৰসংগ</span>
        <h2 class="mt-3">আমি বাস কৰা পৃথিৱী</h2>
        <p>আপুনি সোধা প্ৰতিটো প্ৰশ্নৰ উত্তৰ অনলাইনত ক’ৰবাত আছে। এইটো আছিল আইজাক আছিমভৰ সপোন — মানৱ জ্ঞানৰ সম্পূৰ্ণ বিশ্বকোষ। ইতিহাসত প্ৰথমবাৰৰ বাবে, সেই সপোনটো প্ৰায় সঁচা হৈছে।</p>
        <p>AI-য়ে ইয়াক বহুগুণ সহজ কৰি তুলিছে — আপুনি সোধে, সি উত্তৰ দিয়ে। মাত্ৰ এটা ইণ্টাৰনেট সংযোগৰ প্ৰয়োজন।</p>
        <p>কিন্তু — অসমৰ যিকোনো ব্যক্তিয়ে জানে — বিশ্বৰ বাবে নিৰ্মিত এখন সপোনে পঢ়া ব্যক্তিজনৰ বাবে সদায় উপযুক্ত নহয়।</p>
      </div>
    </section>

    <div class="my-16 text-center">
      <blockquote class="max-w-2xl mx-auto">
        <p class="text-2xl md:text-3xl font-display font-bold text-fg italic leading-snug">
          "অভিগম মানেই বুজা নহয়। বুজা মানেই নিজৰ হোৱা নহয়।"
        </p>
      </blockquote>
    </div>

    <section class="mb-16">
      <div class="content-prose mx-auto">
        <span class="eyebrow">০২ — ব্যৱধান</span>
        <h2 class="mt-3">আমি যি দূৰ কৰিছোঁ</h2>
        <p>যেতিয়া আপুনি গুৱাহাটীৰ এজন ছাত্ৰ, নগাঁওৰ এজন কৃষক, বা শিলচৰৰ এজন স্ব-শিক্ষিত ক’ডাৰ — ইণ্টাৰনেটটো এতিয়াও বেছিভাগ ইংৰাজীত। আৰু যেতিয়া নহয়, তেতিয়া ই এনে এটা প্ৰসংগ ধৰি লয় যি আপোনাৰ সৈতে মিল নাখায়।</p>
        <p>পৰম্পৰাগত শিক্ষা এটা ধীৰ যুগৰ বাবে নিৰ্মিত আছিল। এতিয়া ৰক্ষকসকল হৈছে এলগৰিথম, আৰু নতুন সাক্ষৰতা হৈছে <em>কেনেকৈ শিকিব</em> জনা।</p>
        <p>Axomiya IT Labs ইয়াৰ বাবেই ইয়াত আছে।</p>
      </div>
    </section>

    <section class="my-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="eyebrow">০৩ — আমি কি কৰোঁ</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold font-display">শিকা। নিৰ্মাণ। শেয়াৰ।</h2>
          <p class="text-fg-muted mt-3">তিনিটা শব্দ। এটা সম্প্ৰদায়।</p>
        </div>
        
        <div class="grid gap-6 md:grid-cols-3">
          <div class="card p-8 hover:border-accent transition-colors">
            <div class="w-14 h-14 rounded-xl bg-accent-soft flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h3 class="text-xl font-bold font-display mb-2">শিকা</h3>
            <p class="text-fg-muted text-sm leading-relaxed">
              AI আৰু প্ৰযুক্তিৰ চমু গাইড, টিউটোৰিয়েল, আৰু সহজ ভাষাৰ ব্যাখ্যা — মানুহৰ বাবে, অভিযন্তাৰ বাবে নহয়।
            </p>
          </div>
          
          <div class="card p-8 hover:border-accent transition-colors">
            <div class="w-14 h-14 rounded-xl bg-accent-soft flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </div>
            <h3 class="text-xl font-bold font-display mb-2">নিৰ্মাণ</h3>
            <p class="text-fg-muted text-sm leading-relaxed">
              প্ৰকৃত স্থানীয় সমস্যা সমাধান কৰা প্ৰকৃত প্ৰকল্প, AI সঁজুলি, আৰু প্লেটফৰ্ম।
            </p>
          </div>
          
          <div class="card p-8 hover:border-accent transition-colors">
            <div class="w-14 h-14 rounded-xl bg-accent-soft flex items-center justify-center mb-5">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </div>
            <h3 class="text-xl font-bold font-display mb-2">শেয়াৰ</h3>
            <p class="text-fg-muted text-sm leading-relaxed">
              প্ৰতিটো অনুবাদ, বাগ ৰিপৰ্ট, আৰু সৰু অৱদানে সম্প্ৰদায়ক শক্তিশালী কৰে।
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="my-16">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="eyebrow">০৪ — কাৰ বাবে</span>
          <h2 class="mt-3 text-3xl md:text-4xl font-bold font-display">এইটো কাৰ বাবে</h2>
          <p class="text-fg-muted mt-3">যিকোনো ব্যক্তি যিয়ে কেতিয়াবা ইচ্ছা কৰিছে উত্তৰটো ঘৰৰ পৰা অহাৰ দৰে শুনা যায়।</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            'কৌতূহলী ল’ৰা-ছোৱালী',
            'আটকি যোৱা ছাত্ৰ',
            'সহায়ক অভিভাৱক',
            'উচ্চাকাংক্ষী শিক্ষক',
            'ঘূৰি অহা ডেভেলপাৰ',
            'পথ বিচৰা উদ্যোগী',
            'নতুন কৌতূহলী',
            'জীৱনজুৰা শিক্ষাৰ্থী'
          ].map(who => (
            <div class="card p-5 text-center hover:border-accent transition-colors">
              <p class="text-sm font-semibold text-fg">{who}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="my-16 text-center">
      <blockquote class="max-w-2xl mx-auto">
        <p class="text-2xl md:text-3xl font-display font-bold text-fg italic leading-snug">
          "অসমৰ প্ৰথম AI আৰু মুক্ত-উৎস স্থান, য’ত সকলোকে স্বাগতম।"
        </p>
      </blockquote>
    </div>

    <section class="mb-16">
      <div class="content-prose mx-auto">
        <span class="eyebrow">০৫ — মুক্ত উৎস</span>
        <h2 class="mt-3">কিয় সকলো বিনামূলীয়া</h2>
        <p>কাৰণ যি জ্ঞান পেৱাল, লগইন, বা ব্যক্তিগত কোম্পানীৰ পিছত লুকুৱাই থোৱা থাকে সেয়া প্ৰকৃততে বিনামূলীয়া নহয়। আমি নিৰ্মাণ কৰা সকলো বস্তু মুক্ত-উৎস।</p>
        <p>এইদৰেই দলংখন শক্তিশালী হয়: প্ৰতিজনে এখন তক্তা যোগ কৰে।</p>
      </div>
    </section>

    <section class="my-16">
      <div class="card bg-accent-soft/30 border-accent/20 p-10 md:p-16 text-center max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold font-display mb-4">আমাৰ সৈতে যোগ দিয়ক</h2>
        <p class="text-fg-muted text-lg mb-8 max-w-xl mx-auto">
          যদি আপুনি নিজে জনা বস্তু শেয়াৰ কৰিব বিচাৰে, আনৰ উপকাৰ কৰিব বিচাৰে, আৰু প্ৰকৃত কৌতূহলৰ সৈতে নতুন ক্ষেত্ৰ অন্বেষণ কৰিব বিচাৰে — এইটো আপোনাৰ সম্প্ৰদায়।
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/as/community/" class="btn-primary text-lg px-8 py-3.5">
            সম্প্ৰদায়ত যোগ দিয়ক
          </a>
          <a href="/as/projects/" class="btn-secondary text-lg px-8 py-3.5">
            আমি কি নিৰ্মাণ কৰি আছোঁ চাওক
          </a>
        </div>
      </div>
    </section>

  </article>
</BaseLayout>