---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import AnnouncementsStrip from '../../components/AnnouncementsStrip.astro';
import LatestProjects from '../../components/LatestProjects.astro';
import LatestPosts from '../../components/LatestPosts.astro';

const lang = 'as' as const;
---
<BaseLayout lang={lang} title="Axomiya IT Labs" description="অসমত শিপাই থকা আৰু সকলোৰে বাবে মুকলি AI আৰু মুক্ত-উৎস সম্প্ৰদায়। একেলগে শিকোঁ, নিৰ্মাণ কৰোঁ, আৰু স্থানীয় ধাৰণাক সকলোৰে বাবে উপযোগী প্ৰযুক্তিলৈ ৰূপ দিওঁ।">
  
  <Hero 
    title="আগন্তুক দিন"
    titleAccent="গঢ়ি তোলোঁ আহক।"
    tagline="AI আৰু মুক্ত-উৎসৰ নতুন ঢৌ ইয়াৰ পৰাই আৰম্ভ হওক। শিকোঁতে শিকোঁতে নিৰ্মাণ কৰক, স্থানীয় ধাৰণাক উপযোগী সঁজুলিলৈ ৰূপ দিয়ক, আৰু সকলোৰে বাবে প্ৰযুক্তিক সহজলভ্য কৰাত সহায় কৰক।"
    primaryBtnText="সম্প্ৰদায়ত যোগ দিয়ক"
    primaryBtnLink="/as/community/"
    secondaryBtnText="প্ৰকল্প চাওক"
    secondaryBtnLink="/as/projects/"
  />

  <AnnouncementsStrip lang={lang} />
  
  <LatestProjects lang={lang} />
  
  <LatestPosts lang={lang} />

</BaseLayout>
