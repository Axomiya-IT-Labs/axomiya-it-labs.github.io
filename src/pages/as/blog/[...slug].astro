---
import { getCollection } from 'astro:content';
import BlogArticle from '../../../components/BlogArticle.astro';
export async function getStaticPaths() { return (await getCollection('blog')).filter((p) => p.data.lang === 'as').map((post) => ({ params: { slug: post.data.translationSlug }, props: { post } })); }
const { post } = Astro.props;
---
<BlogArticle post={post} />
