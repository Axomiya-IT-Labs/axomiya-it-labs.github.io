---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => data.lang === 'as')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="as" title="গৱেষণা">
  <div class="container-prose py-16">
    <header class="mb-12 text-center">
      <h1 class="display mb-4">গৱেষণা আৰু প্ৰবন্ধ</h1>
      <p class="lead mx-auto">গভীৰ বিশ্লেষণ, কৌশলগত বিৱৰণ, আৰু কেছ ষ্টাডি।</p>
    </header>

    {posts.length > 0 ? (
      <div class="flex flex-wrap justify-center gap-6">
        {posts.map(post => (
          <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
            <ContentCard entry={post} lang="as" type="research" />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-fg-muted py-12">এতিয়ালৈকে কোনো গৱেষণা পত্ৰ প্ৰকাশ কৰা হোৱা নাই।</p>
    )}
  </div>
</BaseLayout>