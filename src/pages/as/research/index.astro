---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research', ({ data }) => data.lang === 'as')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="as" title="গৱেষণা">
  <div class="container-prose py-16">
    <header class="mb-12">
      <h1 class="display mb-4">গৱেষণা আৰু প্ৰবন্ধ</h1>
      <p class="lead">গভীৰ বিশ্লেষণ, কৌশলগত বিৱৰণ, আৰু কেছ ষ্টাডি।</p>
    </header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map(post => <ContentCard entry={post} lang="as" type="research" />)}
      {posts.length === 0 && <p class="text-fg-muted">এতিয়ালৈকে কোনো গৱেষণা পত্ৰ প্ৰকাশ কৰা হোৱা নাই।</p>}
    </div>
  </div>
</BaseLayout>
