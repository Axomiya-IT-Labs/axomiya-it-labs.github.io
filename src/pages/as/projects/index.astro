---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.lang === 'as'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout lang="as" title="প্ৰকল্প">
  <div class="container-prose py-12 md:py-16">
    <header class="mb-8 md:mb-12">
      <h1 class="display mb-4">প্ৰকল্প</h1>
      <p class="lead">অসমৰ স্থানীয় ধাৰণাৰ পৰা নিৰ্মিত AI আৰু মুক্ত-উৎসৰ সঁজুলি, গৱেষণা আৰু শিক্ষামূলক প্ৰকল্পসমূহ।</p>
    </header>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(project => <ContentCard entry={project} lang="as" type="projects" />)}
      {projects.length === 0 && <p class="text-fg-muted">এতিয়ালৈকে কোনো প্ৰকল্প প্ৰকাশ কৰা হোৱা নাই।</p>}
    </div>
  </div>
</BaseLayout>
