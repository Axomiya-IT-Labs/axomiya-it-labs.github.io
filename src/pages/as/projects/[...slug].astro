---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Prose from '../../../components/Prose.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects', ({ data }) => data.lang === 'as');
  return projects.map(project => ({
    params: { slug: project.data.translationSlug },
    props: { project }
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const logoUrl = project.data.logo || '/brand/logo.png';
---
<BaseLayout lang="as" title={project.data.title} description={project.data.description} ogImage={project.data.ogImage}>
  <article class="container-prose py-16">
    
    <!-- Project Header -->
    <header class="mb-12 flex flex-col md:flex-row items-center md:items-start gap-8 bg-bg-elevated p-8 rounded-2xl border border-border">
      <div class="w-24 h-24 shrink-0 bg-bg-subtle rounded-2xl flex items-center justify-center p-3 border border-border shadow-sm">
        <img src={logoUrl} alt={`${project.data.title} logo`} class="w-full h-full object-contain" />
      </div>
      
      <div class="text-center md:text-left flex-1">
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-3">
          <span class="badge badge-accent font-bold uppercase tracking-wider">{project.data.status}</span>
          {project.data.category && <span class="badge bg-bg-subtle text-fg-muted">{project.data.category}</span>}
        </div>
        
        <h1 class="display mb-3">{project.data.title}</h1>
        <p class="lead mb-6">{project.data.description}</p>
        
        <div class="flex flex-wrap justify-center md:justify-start gap-3">
          {project.data.demo && (
            <a href={project.data.demo} target="_blank" rel="noopener noreferrer" aria-label="লাইভ ডেমো" class="btn-primary inline-flex items-center justify-center gap-2 whitespace-nowrap">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              লাইভ ডেমো
            </a>
          )}
          {project.data.repo && (
            <a href={project.data.repo} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="btn-secondary inline-flex items-center justify-center gap-2 whitespace-nowrap">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.75.5 12.24c0 5.2 3.3 9.6 7.87 11.15.58.1.79-.26.79-.58v-2.23c-3.2.71-3.87-1.55-3.87-1.55-.53-1.37-1.3-1.74-1.3-1.74-1.07-.75.08-.74.08-.74 1.18.08 1.8 1.24 1.8 1.24 1.05 1.84 2.75 1.31 3.42 1 .1-.78.41-1.31.75-1.61-2.55-.3-5.23-1.3-5.23-5.8 0-1.28.45-2.32 1.19-3.14-.12-.3-.52-1.5.11-3.13 0 0 .97-.32 3.17 1.2a10.8 10.8 0 0 1 5.77 0c2.2-1.52 3.16-1.2 3.16-1.2.63 1.63.23 2.83.12 3.13.74.82 1.19 1.86 1.19 3.14 0 4.51-2.69 5.49-5.25 5.78.42.37.79 1.08.79 2.18v3.24c0 .32.21.69.8.58 4.57-1.55 7.87-5.95 7.87-11.15C23.5 5.75 18.35.5 12 .5Z"/></svg>
              GitHub
            </a>
          )}
          {project.data.website && project.data.website !== project.data.demo && (
            <a href={project.data.website} target="_blank" rel="noopener noreferrer" aria-label="ৱেবচাইট" class="btn-secondary inline-flex items-center justify-center gap-2 whitespace-nowrap">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
              ৱেবচাইট
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Hero Image -->
    {project.data.heroImage && (
      <img src={project.data.heroImage} alt="" class="w-full h-auto max-h-[400px] object-cover rounded-2xl shadow-lg mb-12 border border-border" />
    )}

    <!-- Content Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <div class="md:col-span-2">
        <h2 class="text-2xl font-bold mb-6">এই প্ৰকল্পৰ বিষয়ে</h2>
        <Prose>
          <Content />
        </Prose>
      </div>

      <aside class="space-y-8">
        {project.data.tech_stack && project.data.tech_stack.length > 0 && (
          <div class="bg-bg-subtle p-6 rounded-xl border border-border">
            <h3 class="font-bold text-lg mb-4">প্ৰযুক্তি</h3>
            <div class="flex flex-wrap gap-2">
              {project.data.tech_stack.map(tech => (
                <span class="badge bg-bg-elevated border-border text-fg-muted">{tech}</span>
              ))}
            </div>
          </div>
        )}

        {project.data.target_audience && (
          <div class="bg-accent-soft/30 p-6 rounded-xl border border-accent/20">
            <h3 class="font-bold text-lg mb-2 text-accent">এইটো কাৰ বাবে?</h3>
            <p class="text-fg-muted text-sm leading-relaxed">{project.data.target_audience}</p>
          </div>
        )}

        {project.data.why_built && (
          <div class="bg-bg-subtle p-6 rounded-xl border border-border">
            <h3 class="font-bold text-lg mb-2">কিয় নিৰ্মাণ কৰা হৈছিল</h3>
            <p class="text-fg-muted text-sm leading-relaxed">{project.data.why_built}</p>
          </div>
        )}
      </aside>
    </div>

    <!-- FAQ Accordion -->
    {project.data.faq && project.data.faq.length > 0 && (
      <div class="mb-12 max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold mb-6 text-center">সঘনাই সোধা প্ৰশ্ন</h2>
        <div class="space-y-3" id="faq-container">
          {project.data.faq.map((item, i) => (
            <div class="faq-item bg-bg-elevated border border-border rounded-lg overflow-hidden transition-all duration-300">
              <button class="faq-trigger w-full flex items-center justify-between p-4 text-left font-semibold hover:bg-bg-subtle transition-colors">
                <span>{item.q}</span>
                <svg class="w-5 h-5 transition-transform duration-300 shrink-0 faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                <div class="p-4 pt-0 text-fg-muted text-sm leading-relaxed">{item.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="max-w-[68ch] mx-auto">
      <ShareButtons lang="as" url={postUrl} title={project.data.title} />
    </div>
  </article>
</BaseLayout>

<script is:inline>
  const faqTriggers = document.querySelectorAll('.faq-trigger');
  
  faqTriggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      const isOpen = item.classList.contains('open');

      // Close all other open items
      document.querySelectorAll('.faq-item.open').forEach(openItem => {
        if (openItem !== item) {
          openItem.classList.remove('open', 'border-accent');
          openItem.querySelector('.faq-content').style.maxHeight = '0px';
          openItem.querySelector('.faq-icon').style.transform = 'rotate(0deg)';
        }
      });

      // Toggle the clicked item
      if (isOpen) {
        item.classList.remove('open', 'border-accent');
        content.style.maxHeight = '0px';
        icon.style.transform = 'rotate(0deg)';
      } else {
        item.classList.add('open', 'border-accent');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
